generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  name      String?
  points    Int      @default(0)
  streak    Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())

  tasks        Task[]
  goals        Goal[]
  habits       Habit[]
  projects     Project[]
  transactions Transaction[]
  books        Book[]
  entries      JournalEntry[]
}

enum TaskStatus {
  PENDIENTE
  PROGRESO
  COMPLETADA
}

model Task {
  id         String     @id @default(cuid())
  title      String
  category   String?
  priority   String?
  status     TaskStatus @default(PENDIENTE)
  isPriority Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id              String    @id @default(cuid())
  name            String
  description     String?
  category        String?
  priority        String?
  progressPercent Int       @default(0)
  currentLabel    String?
  targetLabel     String?
  deadline        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id        String   @id @default(cuid())
  name      String
  category  String?
  createdAt DateTime @default(now())

  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs   HabitLog[]
}

model HabitLog {
  id   String   @id @default(cuid())
  date DateTime

  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}
enum ProjectStatus {
  IDEA
  PLANIFICACION
  EN_PROGRESO
  PAUSADO
  COMPLETADO
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  status          ProjectStatus @default(IDEA)
  progressPercent Int           @default(0)
  relatedGoal     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  INGRESO
  GASTO
}

model Transaction {
  id       String          @id @default(cuid())
  type     TransactionType
  amount   Int
  category String?
  note     String?
  date     DateTime        @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BookStatus {
  POR_LEER
  LEYENDO
  TERMINADO
}

model Book {
  id            String     @id @default(cuid())
  title         String
  author        String?
  status        BookStatus @default(POR_LEER)
  currentPage   Int        @default(0)
  totalPages    Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String[]
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}